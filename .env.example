# Server-side API Keys (used by backend proxy, never exposed to client)
# DO NOT prefix these with VITE_ - they should remain server-side only
HEYGEN_API_KEY=your_heygen_api_key_here
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
SEEKER_TOKEN=your_seeker_token_here
DID_USERNAME=your_did_username_here
DID_PASSWORD=your_did_password_here

# Client-side Configuration (prefixed with VITE_ to be exposed to client)
VITE_PASSWORD_PROTECTION_ENABLED=true
VITE_APP_PASSWORD=maaruum2030ai

# Note: After deployment, set these environment variables in your hosting platform:
# - Vercel: Project Settings > Environment Variables
# - Netlify: Site Settings > Build & Deploy > Environment
# - Railway/Render: Environment Variables section
